<Window x:Class="CoolifyDeployManager.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource L.AboutTitle}" Width="610" Height="585"
        MinWidth="510" MinHeight="450" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Canvas}" Foreground="{StaticResource Primary}"
        WindowStyle="None" Icon="Assets/CDMOfficial.ico" UseLayoutRounding="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="0"/>
  </shell:WindowChrome.WindowChrome>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="45"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{StaticResource Header}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Cursor="SizeAll">
      <Grid Margin="16,0,6,0">
        <TextBlock Text="{DynamicResource L.AboutTitle}" VerticalAlignment="Center" FontWeight="SemiBold"/>
        <Button Click="Close_Click" Width="36" Height="32" Padding="0"
                HorizontalAlignment="Right" Style="{StaticResource ActionButton}"
                Background="#76303D" ToolTip="{DynamicResource L.Close}">
          <Path Data="M 1,1 L 11,11 M 11,1 L 1,11" Width="12" Height="12"
                Stroke="White" StrokeThickness="2" Stretch="Uniform"/>
        </Button>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="26,22,26,22">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <!-- Scroll the whole information page, not only the support subsection. -->
      <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,0">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
            <Border Background="#433662" CornerRadius="14" Width="60" Height="60" Margin="0,0,14,0">
              <Image Source="Assets/CDMLogo.png" Width="54" Height="54" Stretch="Uniform"
                     RenderOptions.BitmapScalingMode="Fant" SnapsToDevicePixels="True"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Coolify Deploy Manager" FontSize="23" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{DynamicResource L.AboutVersion}" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
            </StackPanel>
          </StackPanel>
          <Border Background="{StaticResource Surface}" CornerRadius="12" Padding="18" Margin="0,0,0,18">
            <StackPanel>
              <TextBlock Text="{DynamicResource L.CreatedBy}" FontSize="11"
                         FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
              <TextBlock Text="Cris0338" FontSize="23" FontWeight="Bold"
                         Margin="0,5,0,10" Foreground="{StaticResource Purple}"/>
              <TextBlock Text="{DynamicResource L.License}" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <TextBlock Text="{DynamicResource L.AboutDescription}"
                     TextWrapping="Wrap" Margin="0,0,0,14" FontSize="13"/>
          <TextBlock Text="{DynamicResource L.Unofficial}"
                     TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,15"/>
          <TextBlock Text="{DynamicResource L.AboutSources}" TextWrapping="Wrap"
                     Foreground="{StaticResource Muted}" Margin="0,0,0,15"/>
          <Border Background="{StaticResource Surface}" CornerRadius="12"
                  BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="15">
            <StackPanel>
              <TextBlock Text="{DynamicResource L.SupportTitle}" FontWeight="SemiBold"
                         FontSize="16" Foreground="{StaticResource Purple}" TextWrapping="Wrap"/>
              <TextBlock Text="{DynamicResource L.SupportDescription}" Margin="0,8,0,11"
                         Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
              <Button Content="{DynamicResource L.SupportOpenPayPal}"
                      ToolTip="https://www.paypal.com/paypalme/Cris0338/"
                      HorizontalAlignment="Left" Style="{StaticResource ActionButton}"
                      Background="{StaticResource Blue}" Click="Support_Click"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <Button Grid.Row="1" Content="{DynamicResource L.Close}" Style="{StaticResource ActionButton}"
              HorizontalAlignment="Right" MinWidth="110" Click="Close_Click" Margin="0,16,0,0"/>
    </Grid>
  </Grid>
</Window>
