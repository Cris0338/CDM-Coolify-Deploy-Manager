<Window x:Class="CoolifyDeployManager.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource L.AboutTitle}" Width="540" Height="450"
        MinWidth="480" MinHeight="430" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource Canvas}" Foreground="{StaticResource Primary}" WindowStyle="None" Icon="Assets/AppIcon.ico">
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="0"/></shell:WindowChrome.WindowChrome>
    <Grid><Grid.RowDefinitions><RowDefinition Height="45"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Background="{StaticResource Header}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Cursor="SizeAll"><Grid Margin="16,0,6,0"><TextBlock Text="{DynamicResource L.AboutTitle}" VerticalAlignment="Center" FontWeight="SemiBold"/><Button Content="✕" Click="Close_Click" Width="36" HorizontalAlignment="Right" Style="{StaticResource ActionButton}" Background="#76303D"/></Grid></Border>
      <Grid Grid.Row="1" Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,24">
            <Border Background="#433662" CornerRadius="14" Width="56" Height="56" Margin="0,0,14,0">
                <TextBlock Text="↟" FontSize="34" Foreground="{StaticResource Purple}"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Coolify Deploy Manager" FontSize="23" FontWeight="Bold" />
                <TextBlock Text="{DynamicResource L.AboutVersion}" Foreground="{StaticResource Muted}" Margin="0,5,0,0" />
            </StackPanel>
        </StackPanel>
        <Border Grid.Row="1" Background="{StaticResource Surface}" CornerRadius="12" Padding="18" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="{DynamicResource L.CreatedBy}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                <TextBlock Text="Cris0338" FontSize="23" FontWeight="Bold" Margin="0,5,0,10" Foreground="{StaticResource Purple}" />
                <TextBlock Text="{DynamicResource L.License}" Foreground="{StaticResource Muted}" />
            </StackPanel>
        </Border>
        <TextBlock Grid.Row="2" Text="{DynamicResource L.AboutDescription}"
                   TextWrapping="Wrap" Margin="0,0,0,14" FontSize="13" />
        <TextBlock Grid.Row="3" Text="{DynamicResource L.Unofficial}"
                   TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,15" />
        <TextBlock Grid.Row="4" Text="{DynamicResource L.AboutSources}"
                   TextWrapping="Wrap" Foreground="{StaticResource Muted}" />
        <Button Grid.Row="5" Content="{DynamicResource L.Close}" Style="{StaticResource ActionButton}"
                HorizontalAlignment="Right" MinWidth="110" Click="Close_Click" Margin="0,15,0,0" />
      </Grid>
    </Grid>
</Window>
