<Window x:Class="CoolifyDeployManager.StartupRegistryWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
  Title="{DynamicResource L.StartupManagerTitle}" Width="790" Height="630"
  MinWidth="560" MinHeight="425" WindowStartupLocation="CenterOwner"
  ResizeMode="CanResize" ShowInTaskbar="False"
  Background="{StaticResource Canvas}" Foreground="{StaticResource Primary}" WindowStyle="None">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="7"
                        GlassFrameThickness="0" CornerRadius="0"/>
  </shell:WindowChrome.WindowChrome>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="46"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border Background="{StaticResource Header}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
      <Grid Margin="16,0,6,0">
        <TextBlock Text="{DynamicResource L.StartupManagerTitle}" FontWeight="SemiBold"
                   VerticalAlignment="Center"/>
        <Button Click="Close_Click" Width="36" Height="32" Padding="0" HorizontalAlignment="Right"
                Style="{StaticResource ActionButton}" Background="#76303D"
                ToolTip="{DynamicResource L.Close}">
          <Path Data="M 1,1 L 11,11 M 11,1 L 1,11" Width="12" Height="12"
                Stroke="White" StrokeThickness="2" Stretch="Uniform"/>
        </Button>
      </Grid>
    </Border>

    <StackPanel Grid.Row="1" Margin="22,17,22,12">
      <TextBlock Text="{DynamicResource L.StartupManagerIntro}"
                 Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12"/>
      <DockPanel Margin="0,13,0,0">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <Button x:Name="RefreshButton" Style="{StaticResource ActionButton}"
                  Content="{DynamicResource L.StartupManagerRefresh}"
                  Click="Refresh_Click" Margin="7,0,0,0"/>
        </StackPanel>
        <TextBlock x:Name="FoundCount" VerticalAlignment="Center"
                   Foreground="{StaticResource Purple}" FontWeight="SemiBold"/>
      </DockPanel>
    </StackPanel>

    <Border Grid.Row="2" Background="{StaticResource Surface}" CornerRadius="9"
            BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="22,0,22,0">
      <Grid>
        <TextBlock x:Name="EmptyMessage" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                   TextAlignment="Center" Margin="18"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Margin="8">
          <ItemsControl x:Name="RegistrationList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                        Padding="10,13">
                  <DockPanel LastChildFill="True">
                    <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Checked="Selection_Changed" Unchecked="Selection_Changed"
                              VerticalAlignment="Top" Margin="0,5,12,0"/>
                    <StackPanel>
                      <WrapPanel>
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                   Foreground="{StaticResource Primary}" Margin="0,0,8,0"/>
                        <Border Background="#17392C" CornerRadius="5" Padding="7,2"
                                Visibility="{Binding CurrentVisibility}">
                          <TextBlock Text="{DynamicResource L.StartupManagerCurrentBadge}"
                                     Foreground="{StaticResource Green}"
                                     FontWeight="SemiBold" FontSize="11"/>
                        </Border>
                      </WrapPanel>
                      <TextBlock Text="{Binding Command}" TextWrapping="Wrap" FontSize="12"
                                 Foreground="{StaticResource Primary}" Margin="0,6,0,0"/>
                      <TextBlock Text="{Binding RegistryLocation}" TextWrapping="Wrap" FontSize="11"
                                 Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>

    <StackPanel Grid.Row="3" Margin="22,12,22,17">
      <TextBlock x:Name="StatusMessage" Foreground="{StaticResource Muted}" FontSize="12"
                 TextWrapping="Wrap" Margin="0,0,0,12"/>
      <Border x:Name="ConfirmPanel" Visibility="Collapsed" Margin="0,0,0,12"
              Background="{StaticResource Surface}" BorderBrush="{StaticResource Purple}"
              BorderThickness="1" CornerRadius="8" Padding="12">
        <StackPanel>
          <TextBlock x:Name="ConfirmText" TextWrapping="Wrap" Foreground="{StaticResource Primary}"
                     Margin="0,0,0,10"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelDeleteButton" Style="{StaticResource ActionButton}"
                    Content="{DynamicResource L.Cancel}" Click="CancelDelete_Click" Margin="0,0,8,0"/>
            <Button x:Name="ConfirmDeleteButton" Style="{StaticResource ActionButton}"
                    Content="{DynamicResource L.StartupManagerConfirmDelete}"
                    Background="#76303D" Click="ConfirmDelete_Click"/>
          </StackPanel>
        </StackPanel>
      </Border>
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
          <Button x:Name="SelectAllButton" Style="{StaticResource ActionButton}"
                  Content="{DynamicResource L.StartupManagerSelectAll}" Click="SelectAll_Click"
                  Margin="0,0,8,0"/>
          <Button x:Name="ClearSelectionButton" Style="{StaticResource ActionButton}"
                  Content="{DynamicResource L.StartupManagerSelectNone}" Click="SelectNone_Click"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <TextBlock x:Name="SelectionCount" Foreground="{StaticResource Muted}"
                     VerticalAlignment="Center" Margin="0,0,12,0"/>
          <Button x:Name="DeleteSelectedButton" Style="{StaticResource ActionButton}"
                  Content="{DynamicResource L.StartupManagerDeleteSelected}"
                  Background="#76303D" Click="DeleteSelected_Click"
                  IsEnabled="False" Margin="0,0,8,0"/>
          <Button Style="{StaticResource ActionButton}" Content="{DynamicResource L.Close}"
                  Click="Close_Click"/>
        </StackPanel>
      </DockPanel>
    </StackPanel>
  </Grid>
</Window>
