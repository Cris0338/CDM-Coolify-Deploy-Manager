<Window x:Class="CoolifyDeployManager.GuideWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
  Title="{DynamicResource L.GuideTitle}" Width="640" Height="820" MinWidth="460" MinHeight="450"
  WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize"
  Background="{StaticResource Canvas}" Foreground="{StaticResource Primary}" WindowStyle="None">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="0"/>
  </shell:WindowChrome.WindowChrome>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="45"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="{StaticResource Header}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
      <Grid Margin="16,0,6,0">
        <TextBlock Text="{DynamicResource L.GuideTitle}" VerticalAlignment="Center" FontWeight="SemiBold"/>
        <Button Click="Close_Click" Width="36" Height="32" Padding="0" HorizontalAlignment="Right"
          Style="{StaticResource ActionButton}" Background="#76303D" ToolTip="{DynamicResource L.Close}">
          <Path Data="M 1,1 L 11,11 M 11,1 L 1,11" Width="12" Height="12"
            Stroke="White" StrokeThickness="2" Stretch="Uniform"/>
        </Button>
      </Grid>
    </Border>
    <DockPanel Grid.Row="1" Margin="25">
      <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
        <TextBlock Text="{DynamicResource L.GuideHeading}" FontSize="21" FontWeight="Bold"
          TextWrapping="Wrap"/>
        <TextBlock Text="{DynamicResource L.V3GuideIntro}" Foreground="{StaticResource Muted}"
          FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
      </StackPanel>
      <Button DockPanel.Dock="Bottom" Style="{StaticResource ActionButton}"
        Content="{DynamicResource L.GuideClose}" Click="Close_Click"
        HorizontalAlignment="Right" Margin="0,13,0,0"/>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <TextBlock Text="{DynamicResource L.Guide1}" Foreground="{StaticResource Purple}" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock Text="{DynamicResource L.Guide1Body}" Foreground="{StaticResource Primary}" FontSize="13" TextWrapping="Wrap" Margin="0,7,0,19"/>
          <TextBlock Text="{DynamicResource L.Guide2}" Foreground="{StaticResource Purple}" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock Text="{DynamicResource L.Guide2Body}" Foreground="{StaticResource Primary}" FontSize="13" TextWrapping="Wrap" Margin="0,7,0,19"/>
          <TextBlock Text="{DynamicResource L.Guide3}" Foreground="{StaticResource Purple}" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock Text="{DynamicResource L.Guide3Body}" Foreground="{StaticResource Primary}" FontSize="13" TextWrapping="Wrap" Margin="0,7,0,19"/>
          <TextBlock Text="{DynamicResource L.Guide4}" Foreground="{StaticResource Purple}" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock Text="{DynamicResource L.Guide4Body}" Foreground="{StaticResource Primary}" FontSize="13" TextWrapping="Wrap" Margin="0,7,0,19"/>
          <TextBlock Text="{DynamicResource L.Guide5}" Foreground="{StaticResource Purple}" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock Text="{DynamicResource L.Guide5Body}" Foreground="{StaticResource Primary}" FontSize="13" TextWrapping="Wrap" Margin="0,7,0,19"/>
          <TextBlock Text="{DynamicResource L.Guide6}" Foreground="{StaticResource Purple}" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock Text="{DynamicResource L.Guide6Body}" Foreground="{StaticResource Primary}" FontSize="13" TextWrapping="Wrap" Margin="0,7,0,19"/>
          <TextBlock Text="{DynamicResource L.Guide7}" Foreground="{StaticResource Purple}" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock Text="{DynamicResource L.Guide7Body}" Foreground="{StaticResource Primary}" FontSize="13" TextWrapping="Wrap" Margin="0,7,0,19"/>
          <TextBlock Text="{DynamicResource L.Guide8}" Foreground="{StaticResource Purple}" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock Text="{DynamicResource L.Guide8Body}" Foreground="{StaticResource Primary}" FontSize="13" TextWrapping="Wrap" Margin="0,7,0,19"/>
          <TextBlock Text="{DynamicResource L.Guide9}" Foreground="{StaticResource Purple}" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock Text="{DynamicResource L.Guide9Body}" Foreground="{StaticResource Primary}" FontSize="13" TextWrapping="Wrap" Margin="0,7,0,19"/>
          <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                  BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,8,0,16">
            <StackPanel>
              <TextBlock Text="{DynamicResource L.StartupManagerSectionTitle}" Foreground="{StaticResource Purple}"
                         FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <TextBlock Text="{DynamicResource L.StartupManagerSectionHelp}" FontSize="12"
                         Foreground="{StaticResource Primary}" TextWrapping="Wrap" Margin="0,0,0,12"/>
              <Button x:Name="OpenStartupManagerButton" Style="{StaticResource ActionButton}"
                      Content="{DynamicResource L.StartupManagerOpen}" Click="OpenStartupManager_Click"
                      HorizontalAlignment="Left"/>
            </StackPanel>
          </Border>
          <TextBlock Text="{DynamicResource L.V3GuideApiReference}" Foreground="{StaticResource Muted}"
            TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"/>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Grid>
</Window>
