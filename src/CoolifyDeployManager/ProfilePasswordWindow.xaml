<Window x:Class="CoolifyDeployManager.ProfilePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        WindowStyle="None" ResizeMode="NoResize" Width="510" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Background="{StaticResource Canvas}">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0"/>
  </shell:WindowChrome.WindowChrome>
  <Border BorderBrush="{StaticResource Line}" BorderThickness="1" Background="{StaticResource Canvas}">
    <StackPanel>
      <Border Background="{StaticResource Header}" Padding="16,12" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <TextBlock x:Name="Heading" FontWeight="Bold" FontSize="15"/>
      </Border>
      <StackPanel Margin="25,22,25,24">
        <TextBlock x:Name="Description" TextWrapping="Wrap" Margin="0,0,0,16" Foreground="{StaticResource Muted}"/>
        <TextBlock x:Name="PasswordLabel" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <PasswordBox x:Name="PasswordInput" Margin="0,0,0,12"/>
        <StackPanel x:Name="ConfirmationPanel">
          <TextBlock x:Name="ConfirmationLabel" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <PasswordBox x:Name="ConfirmationInput" Margin="0,0,0,12"/>
        </StackPanel>
        <TextBlock x:Name="ErrorLabel" TextWrapping="Wrap" Foreground="{StaticResource Red}"
                   Margin="0,2,0,12" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
          <Button x:Name="CancelButton" Click="Cancel_Click" Style="{StaticResource ActionButton}"
                  Width="115" Margin="0,0,10,0"/>
          <Button x:Name="SubmitButton" Click="Submit_Click" Background="{StaticResource Purple}"
                  Style="{StaticResource ActionButton}" MinWidth="125" IsDefault="True"/>
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
