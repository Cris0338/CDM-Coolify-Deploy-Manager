<!-- Official CDM logo is already a transparent PNG. The whole WPF splash
     has per-pixel transparency: no rectangular frame, backdrop or footer. -->
<Window x:Class="CoolifyDeployManager.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="930" Height="625" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowActivated="False">
  <!-- No opaque ancestor: only the logo, electron and particles draw pixels. -->
  <Grid x:Name="LogoStage" Width="900" Height="530"
        Background="Transparent" ClipToBounds="False"
        HorizontalAlignment="Center" VerticalAlignment="Center"
        IsHitTestVisible="False">
        <!-- The electron uses separate layers, behind and in front of the real logo. -->
        <Canvas x:Name="BackOrbit" Width="900" Height="530" IsHitTestVisible="False">
          <Ellipse x:Name="BackElectron" Width="50" Height="50" Visibility="Collapsed" Opacity=".55">
            <Ellipse.Fill>
              <RadialGradientBrush>
                <GradientStop Color="#FAFFFFFF" Offset="0"/>
                <GradientStop Color="#50BFFF" Offset=".28"/>
                <GradientStop Color="#1374FE" Offset=".62"/>
                <GradientStop Color="#020E54" Offset="1"/>
              </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect><DropShadowEffect BlurRadius="24" Color="#3899FF" ShadowDepth="0" Opacity=".9"/></Ellipse.Effect>
          </Ellipse>
        </Canvas>
        <Image x:Name="LogoArtwork" Width="900" Height="530" Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"/>
        <TextBlock x:Name="FallbackLogo" Visibility="Collapsed" Text="CDM" FontFamily="Segoe UI"
                   Foreground="#9AAEFF" FontWeight="Black" FontSize="148"
                   HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#2676FF" Opacity="1"/></TextBlock.Effect>
        </TextBlock>
        <Canvas x:Name="FrontOrbit" Width="900" Height="530" IsHitTestVisible="False">
          <Ellipse x:Name="FrontElectron" Width="50" Height="50" Visibility="Collapsed">
            <Ellipse.Fill>
              <RadialGradientBrush>
                <GradientStop Color="#FFFFFFFF" Offset="0"/>
                <GradientStop Color="#85F1FF" Offset=".22"/>
                <GradientStop Color="#177EFC" Offset=".65"/>
                <GradientStop Color="#2A0A7A" Offset="1"/>
              </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect><DropShadowEffect BlurRadius="35" ShadowDepth="0" Color="#477CFF" Opacity="1"/></Ellipse.Effect>
          </Ellipse>
        </Canvas>
        <Canvas x:Name="ParticleLayer" Width="900" Height="530" IsHitTestVisible="False"/>

  </Grid>
</Window>
