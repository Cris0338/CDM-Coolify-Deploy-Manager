<!-- Official CDM artwork is provided by the user-approved transparent PNG resource. -->
<Window x:Class="CoolifyDeployManager.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="930" Height="625" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" Topmost="True">
  <Border x:Name="SplashShell" CornerRadius="23" Background="#111827" BorderBrush="#51419C" BorderThickness="1" ClipToBounds="True">
    <Grid>
      <Grid.Background>
        <RadialGradientBrush Center="0.5,0.48" GradientOrigin="0.48,0.43" RadiusX="0.82" RadiusY="0.98">
          <GradientStop Color="#23365E" Offset="0"/>
          <GradientStop Color="#151E33" Offset="0.51"/>
          <GradientStop Color="#090F1C" Offset="1"/>
        </RadialGradientBrush>
      </Grid.Background>
      <Canvas Width="920" Height="610" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
        <Ellipse Canvas.Left="112" Canvas.Top="125" Width="675" Height="345" Stroke="#2369D9" StrokeThickness="1" StrokeDashArray="5 6" Opacity=".25"/>
        <Ellipse Canvas.Left="152" Canvas.Top="139" Width="600" Height="333" Stroke="#9B56F8" StrokeThickness="1" Opacity=".2"/>
      </Canvas>
      <Grid x:Name="LogoStage" Width="900" Height="530" HorizontalAlignment="Center" VerticalAlignment="Center">
        <!-- The electron uses separate layers, behind and in front of the real logo. -->
        <Canvas x:Name="BackOrbit" Width="900" Height="530" IsHitTestVisible="False">
          <Ellipse x:Name="BackElectron" Width="50" Height="50" Visibility="Collapsed" Opacity=".55">
            <Ellipse.Fill>
              <RadialGradientBrush>
                <GradientStop Color="#FAFFFFFF" Offset="0"/>
                <GradientStop Color="#50BFFF" Offset=".28"/>
                <GradientStop Color="#1374FE" Offset=".62"/>
                <GradientStop Color="#020E54" Offset="1"/>
              </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect><DropShadowEffect BlurRadius="24" Color="#3899FF" ShadowDepth="0" Opacity=".9"/></Ellipse.Effect>
          </Ellipse>
        </Canvas>
        <Image x:Name="LogoArtwork" Width="900" Height="530" Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False"/>
        <TextBlock x:Name="FallbackLogo" Visibility="Collapsed" Text="CDM" FontFamily="Segoe UI"
                   Foreground="#9AAEFF" FontWeight="Black" FontSize="148"
                   HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#2676FF" Opacity="1"/></TextBlock.Effect>
        </TextBlock>
        <Canvas x:Name="FrontOrbit" Width="900" Height="530" IsHitTestVisible="False">
          <Ellipse x:Name="FrontElectron" Width="50" Height="50" Visibility="Collapsed">
            <Ellipse.Fill>
              <RadialGradientBrush>
                <GradientStop Color="#FFFFFFFF" Offset="0"/>
                <GradientStop Color="#85F1FF" Offset=".22"/>
                <GradientStop Color="#177EFC" Offset=".65"/>
                <GradientStop Color="#2A0A7A" Offset="1"/>
              </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect><DropShadowEffect BlurRadius="35" ShadowDepth="0" Color="#477CFF" Opacity="1"/></Ellipse.Effect>
          </Ellipse>
        </Canvas>
        <Canvas x:Name="ParticleLayer" Width="900" Height="530" IsHitTestVisible="False"/>
      </Grid>
      <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16">
        <TextBlock Text="COOLIFY DEPLOY MANAGER" Foreground="#C2CBEB" FontSize="11"
                   FontFamily="Consolas" HorizontalAlignment="Center" Opacity=".88"/>
        <TextBlock Text="Avvio della dashboard..." Foreground="#7992C9" FontSize="11"
                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
