<Window x:Class="CoolifyDeployManager.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="Coolify Deploy Manager 2.2.0" WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource Canvas}" Foreground="{StaticResource Primary}" Width="1500" Height="920" MinWidth="850" MinHeight="570" Icon="Assets/CDMOfficial.ico" Loaded="Window_Loaded" Closing="Window_Closing" KeyDown="Window_KeyDown" WindowStartupLocation="CenterScreen">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="0"/></shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <!-- Own the entire menu template so Windows' light checkmark gutter never leaks into the dark UI. -->
    <Style x:Key="DarkCardContextMenu" TargetType="{x:Type ContextMenu}">
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="Foreground" Value="{StaticResource Primary}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ContextMenu}">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="5">
              <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DarkCardMenuItem" TargetType="{x:Type MenuItem}">
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="Foreground" Value="{StaticResource Primary}"/>
      <Setter Property="MinWidth" Value="185"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type MenuItem}">
            <Border x:Name="MenuRow" Background="{TemplateBinding Background}" CornerRadius="5" Padding="10,8">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="CheckSquare" Grid.Column="0" Width="16" Height="16" CornerRadius="4"
                        BorderThickness="1" BorderBrush="{StaticResource Muted}" Background="Transparent"
                        VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <Path x:Name="MenuCheck" Grid.Column="0" Visibility="Collapsed" Width="11" Height="10"
                      Stroke="{StaticResource Green}" StrokeThickness="2.2" StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform"
                      Data="M 1,5 L 4.5,8.5 L 10,1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                  Margin="9,0,4,0" VerticalAlignment="Center"
                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="MenuCheck" Property="Visibility" Value="Visible"/>
                <Setter TargetName="CheckSquare" Property="BorderBrush" Value="{StaticResource Green}"/>
                <Setter TargetName="CheckSquare" Property="Background" Value="#1B3936"/>
              </Trigger>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="MenuRow" Property="Background" Value="{StaticResource Hover}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="MenuRow" Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="ApplicationCard">
      <Border Width="345" MinHeight="267" CornerRadius="13" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,14,14" Padding="16" Cursor="Hand" AllowDrop="True" PreviewDragOver="Card_DragOver" PreviewDrop="Card_Drop" PreviewMouseLeftButtonDown="Card_PreviewMouseLeftButtonDown" PreviewMouseMove="Card_PreviewMouseMove" PreviewMouseLeftButtonUp="Card_PreviewMouseLeftButtonUp" LostMouseCapture="Card_LostMouseCapture" Loaded="Card_Loaded">
        <Border.ContextMenu>
          <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Style="{StaticResource DarkCardContextMenu}">
            <MenuItem Style="{StaticResource DarkCardMenuItem}" Header="{DynamicResource L.LockPosition}" IsCheckable="True" IsChecked="{Binding PositionLocked, Mode=OneWay}" Click="TogglePositionLock_Click"/>
            <MenuItem Style="{StaticResource DarkCardMenuItem}" Header="{DynamicResource L.LockDeploy}" IsCheckable="True" IsChecked="{Binding DeployLocked, Mode=OneWay}" Click="ToggleDeployLock_Click"/>
          </ContextMenu>
        </Border.ContextMenu>
        <Border.Style>
          <Style TargetType="Border"><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Purple}"/></Trigger></Style.Triggers></Style>
        </Border.Style>
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" Visibility="{Binding SelectionVisibility}" Margin="0,2,10,0" VerticalAlignment="Top" ToolTip="{DynamicResource L.SelectForDeploy}"/>
            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="45" ToolTip="{Binding FullDescription}"/>
            <Border Grid.Column="2" Background="{StaticResource Hover}" CornerRadius="6" Padding="8,6" Margin="8,0,0,0" Cursor="SizeAll" ToolTip="{DynamicResource L.DragTooltip}" PreviewMouseLeftButtonDown="Grip_Down" PreviewMouseMove="Grip_Move">
              <TextBlock Text="⠿" FontSize="17" Foreground="{StaticResource Muted}" IsHitTestVisible="False"/>
            </Border>
          </Grid>
          <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="{Binding Environment}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Environment}"/>
            <Border Background="{StaticResource Header}" CornerRadius="5" Padding="6,5" Margin="0,7,0,0" HorizontalAlignment="Left" MaxWidth="305">
              <TextBlock Text="{Binding Branch}" FontFamily="Consolas" FontSize="11" Foreground="#B9B7F6" TextTrimming="CharacterEllipsis" ToolTip="{Binding Branch}"/>
            </Border>
          </StackPanel>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,14">
            <Border Background="{Binding RunningBrush}" CornerRadius="12" Padding="10,5" Margin="0,0,7,0"><TextBlock Text="{Binding RunningLabel}" FontWeight="SemiBold" FontSize="11"/></Border>
            <Border Background="{Binding HealthBrush}" CornerRadius="12" Padding="10,5"><TextBlock Text="{Binding HealthLabel}" FontWeight="SemiBold" FontSize="11"/></Border>
          </StackPanel>
          <StackPanel Grid.Row="3" Margin="0,0,0,13">
            <TextBlock Text="{Binding LastDeploy}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding LastStatus}" Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <Button Grid.Row="4" Style="{StaticResource ActionButton}" Background="{Binding DeployBrush}" Content="{Binding DeployCaption}" Click="Deploy_Click" Tag="{Binding}" IsEnabled="{Binding CanDeploy}"/>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>
  <Grid Background="{StaticResource Canvas}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{StaticResource Header}" Padding="22,18">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Cursor="SizeAll">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Grid Width="48" Height="48" Margin="0,0,12,0" Background="Transparent">
              <Image Source="Assets/CDMLogo.png" Width="46" Height="46" Stretch="Uniform"
                     RenderOptions.BitmapScalingMode="Fant" SnapsToDevicePixels="True"/>
            </Grid>
            <TextBlock Text="Coolify Deploy Manager" FontSize="21" FontWeight="Bold" VerticalAlignment="Center"/>
            <Border Background="#352C4B" CornerRadius="8" Margin="10,0,0,0" Padding="8,4"><TextBlock Text="WPF 2.2.0" FontSize="11" Foreground="{StaticResource Purple}"/></Border>
            <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="10,0,0,0" MaxWidth="340">
              <Border Background="{StaticResource Surface}" CornerRadius="8" HorizontalAlignment="Left" Padding="10,5">
                <TextBlock x:Name="ProfileBadge" Text="{DynamicResource L.VaultNotConfigured}" FontSize="11" Foreground="{StaticResource Green}"/>
              </Border>
              <Border Background="{StaticResource Surface}" CornerRadius="8" HorizontalAlignment="Left" Padding="10,5"
                      Margin="0,5,0,0" MaxWidth="340"
                      Visibility="{Binding ElementName=ProfileIdentity, Path=Visibility}">
                <TextBlock x:Name="ProfileIdentity" Foreground="{StaticResource Green}" FontSize="11"
                           FontWeight="Normal" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Visibility="Collapsed"/>
              </Border>
            </StackPanel>
          </StackPanel>
          <TextBlock Text="{DynamicResource L.Subtitle}" Foreground="{StaticResource Muted}" FontSize="12" Margin="47,3,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse x:Name="ConnectionDot" Width="9" Height="9" Fill="{StaticResource Red}" Margin="0,0,7,0"/>
          <TextBlock x:Name="ConnectionText" Text="{DynamicResource L.NotConnected}" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,0,18,0"/>
          <Button x:Name="RefreshButton" Style="{StaticResource ActionButton}" Content="{DynamicResource L.Refresh}" Background="{StaticResource Purple}" Click="Refresh_Click" Margin="0,0,8,0"/>
          <Button Style="{StaticResource ActionButton}" Content="{DynamicResource L.Configuration}" Click="Settings_Click" Margin="0,0,8,0"/>
          <Button Style="{StaticResource ActionButton}" Content="{DynamicResource L.ApiGuide}" Click="Guide_Click" Margin="0,0,8,0"/>
          <Button Style="{StaticResource ActionButton}" Content="{DynamicResource L.About}" Click="About_Click"/>
          <Border Background="{StaticResource Line}" Width="1" Margin="13,5"/>
          <Button Content="—" Style="{StaticResource ActionButton}" Width="36" Padding="0" Click="Minimize_Click" ToolTip="Minimize"/>
          <Button Content="□" Style="{StaticResource ActionButton}" Width="36" Padding="0" Margin="4,0,0,0" Click="Maximize_Click" ToolTip="Maximize / Restore"/>
          <Button Style="{StaticResource ActionButton}" Width="36" Height="34" Padding="0" Margin="4,0,0,0" Background="#76303D" Click="CloseWindow_Click" ToolTip="Close"><Path Data="M 1,1 L 11,11 M 11,1 L 1,11" Width="12" Height="12" Stroke="White" StrokeThickness="2" Stretch="Uniform"/></Button>
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="1" Background="{StaticResource Header}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,1" Padding="22,9">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{DynamicResource L.Project}" Foreground="{StaticResource Muted}" Margin="0,0,10,0" VerticalAlignment="Center"/>
          <Grid Width="260" Margin="0,0,12,0">
            <Button x:Name="ProjectPickerButton" Style="{StaticResource ActionButton}" Content="{DynamicResource L.AllProjects}" Click="ProjectPicker_Click" HorizontalContentAlignment="Left" Width="260"/>
            <Popup x:Name="ProjectPickerPopup" PlacementTarget="{Binding ElementName=ProjectPickerButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
              <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Purple}" BorderThickness="1" CornerRadius="9" Padding="10" Width="330">
                <StackPanel>
                  <TextBox x:Name="ProjectSearchBox" TextChanged="ProjectSearchBox_TextChanged" ToolTip="{DynamicResource L.SearchProjects}" Margin="0,0,0,8"/>
                  <ListBox x:Name="ProjectPickerList" SelectionChanged="ProjectPickerList_SelectionChanged" DisplayMemberPath="Name" Background="{StaticResource Surface}" Foreground="{StaticResource Primary}" BorderThickness="0" MaxHeight="310"/>
                </StackPanel>
              </Border>
            </Popup>
          </Grid>
          <TextBlock x:Name="InventoryCount" Text="0 applications" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Style="{StaticResource ActionButton}" Background="{StaticResource Blue}" Content="{DynamicResource L.SelectedStaging}" Click="Batch_Click" Margin="0,0,8,0"/>
          <Button Style="{StaticResource ActionButton}" Background="{StaticResource Hover}" Content="{DynamicResource L.AllStaging}" Click="BatchAll_Click" Margin="0,0,8,0"/>
          <Button x:Name="CancelButton" Style="{StaticResource ActionButton}" Content="{DynamicResource L.StopQueue}" Click="Cancel_Click" IsEnabled="False"/>
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="2" Background="{StaticResource Canvas}" Padding="22,13">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
        <TextBox x:Name="SearchBox" Grid.Column="0" TextChanged="Search_Changed" Margin="0,0,9,0" ToolTip="{DynamicResource L.SearchHint}"/>
        <ComboBox x:Name="StatusFilter" Grid.Column="1" SelectionChanged="Filter_Changed" SelectedIndex="0">
          <ComboBoxItem Content="{DynamicResource L.All}"/><ComboBoxItem Content="{DynamicResource L.RunningFilter}"/><ComboBoxItem Content="{DynamicResource L.Problems}"/><ComboBoxItem Content="{DynamicResource L.Unclassified}"/>
        </ComboBox>
      </Grid>
    </Border>
    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="22,5,8,0">
      <StackPanel>
        <StackPanel x:Name="StageSection" Margin="0,0,0,12">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Border Background="{StaticResource Blue}" Width="4" CornerRadius="3" Margin="0,0,12,0"/>
            <TextBlock Text="{DynamicResource L.Staging}" FontSize="14" FontWeight="Bold"/>
            <TextBlock x:Name="StageCount" Text="0 applications" Foreground="{StaticResource Muted}" Margin="12,2,0,0"/>
          </StackPanel>
          <ItemsControl x:Name="StagingItems" ItemTemplate="{StaticResource ApplicationCard}" Tag="Staging" AllowDrop="True" PreviewDragOver="EmptyArea_DragOver" PreviewDrop="EmptyArea_Drop">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel MinHeight="70"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          </ItemsControl>
          <Border Tag="Staging" Height="52" CornerRadius="8" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,14,10" Padding="12,8" AllowDrop="True" PreviewDragOver="EmptyArea_DragOver" PreviewDrop="EmptyArea_Drop"><TextBlock Text="{DynamicResource L.DropToEnd}" VerticalAlignment="Center" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/></Border>
        </StackPanel>
        <StackPanel x:Name="ProductionSection" Margin="0,4,0,12">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Border Background="{StaticResource Red}" Width="4" CornerRadius="3" Margin="0,0,12,0"/>
            <TextBlock Text="{DynamicResource L.Production}" FontSize="14" FontWeight="Bold"/>
            <TextBlock x:Name="ProductionCount" Text="0 applications" Foreground="{StaticResource Muted}" Margin="12,2,0,0"/>
          </StackPanel>
          <ItemsControl x:Name="ProductionItems" ItemTemplate="{StaticResource ApplicationCard}" Tag="Production" AllowDrop="True" PreviewDragOver="EmptyArea_DragOver" PreviewDrop="EmptyArea_Drop"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel MinHeight="70"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
          <Border Tag="Production" Height="52" CornerRadius="8" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,14,10" Padding="12,8" AllowDrop="True" PreviewDragOver="EmptyArea_DragOver" PreviewDrop="EmptyArea_Drop"><TextBlock Text="{DynamicResource L.DropToEnd}" VerticalAlignment="Center" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/></Border>
        </StackPanel>
        <StackPanel x:Name="UnknownSection" Margin="0,4,0,12">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Border Background="{StaticResource Muted}" Width="4" CornerRadius="3" Margin="0,0,12,0"/>
            <TextBlock Text="{DynamicResource L.UnclassifiedTitle}" FontSize="14" FontWeight="Bold"/>
            <TextBlock x:Name="UnknownCount" Text="0 applications" Foreground="{StaticResource Muted}" Margin="12,2,0,0"/>
          </StackPanel>
          <ItemsControl x:Name="UnknownItems" ItemTemplate="{StaticResource ApplicationCard}" Tag="Unknown" AllowDrop="True" PreviewDragOver="EmptyArea_DragOver" PreviewDrop="EmptyArea_Drop"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel MinHeight="70"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
          <Border Tag="Unknown" Height="52" CornerRadius="8" BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,14,10" Padding="12,8" AllowDrop="True" PreviewDragOver="EmptyArea_DragOver" PreviewDrop="EmptyArea_Drop"><TextBlock Text="{DynamicResource L.DropToEnd}" VerticalAlignment="Center" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/></Border>
        </StackPanel>
        <TextBlock x:Name="EmptyLabel" Text="{DynamicResource L.NoneMatch}" FontSize="15" Foreground="{StaticResource Muted}" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,20,0,20"/>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="4" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="15,8" Background="{StaticResource Header}">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="OperationText" Text="{DynamicResource L.Ready}" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Content="{DynamicResource L.ToggleLog}" Style="{StaticResource ActionButton}" Click="ToggleLog_Click" Padding="10,5"/>
      </Grid>
    </Border>
    <Border x:Name="LogPanel" Grid.Row="5" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Background="#0C0F15" Height="150">
      <Grid Margin="16,9">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
          <TextBlock Text="{DynamicResource L.ActivityLog}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
          <Button Content="{DynamicResource L.Copy}" Click="CopyLog_Click" Foreground="{StaticResource Purple}" Background="Transparent" BorderThickness="0" Margin="18,0,0,0" Cursor="Hand"/>
          <Button Content="{DynamicResource L.Clear}" Click="ClearLog_Click" Foreground="{StaticResource Muted}" Background="Transparent" BorderThickness="0" Margin="12,0,0,0" Cursor="Hand"/>
        </StackPanel>
        <TextBox Grid.Row="1" x:Name="LogBox" Background="Transparent" BorderThickness="0" Foreground="#AAB5C8" FontFamily="Consolas" FontSize="12" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
      </Grid>
    </Border>
  </Grid>
</Window>
